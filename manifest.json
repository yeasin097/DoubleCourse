{
  "manifest_version": 3,
  "name": "Course Duplicate Finder",
  "version": "1.0",
  "description": "Finds duplicate course entries on the enrollment page.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://edu.orbund.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}




